<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.danieljhkim.kvdb</groupId>
        <artifactId>kvdb</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>coverage</artifactId>
    <packaging>pom</packaging>

    <dependencies>
        <dependency>
            <groupId>com.danieljhkim.kvdb</groupId>
            <artifactId>kv.common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.danieljhkim.kvdb</groupId>
            <artifactId>kv.coordinator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.danieljhkim.kvdb</groupId>
            <artifactId>kv.node</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.danieljhkim.kvdb</groupId>
            <artifactId>kv.client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.danieljhkim.kvdb</groupId>
            <artifactId>kv.proto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.danieljhkim.kvdb</groupId>
            <artifactId>kv.gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.danieljhkim.kvdb</groupId>
            <artifactId>kv.admin</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <includeCurrentProject>false</includeCurrentProject>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>aggregate-coverage-floor</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>awk</executable>
                            <arguments>
                                <argument>-F,</argument>
                                <argument>-v</argument>
                                <argument>floor=${jacoco.aggregate.minimum.line.coverage}</argument>
                                <argument>NR &gt; 1 { missed += $8; covered += $9 } END { total = missed + covered; ratio = total ? covered / total : 0; printf "Aggregate line coverage: %.2f%% (floor %.2f%%)\n", ratio * 100, floor * 100; if (ratio + 0.0000001 &lt; floor) exit 1 }</argument>
                                <argument>${project.build.directory}/site/jacoco-aggregate/jacoco.csv</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
